# Leave empty to use the in-browser mock backend (seeded demo data).
# Set to the Supabase Edge Function base URL once the APIs are live, e.g.
# VITE_API_BASE_URL=https://<project>.supabase.co/functions/v1/flight-api
VITE_API_BASE_URL=
# Optional bearer token (e.g. Supabase anon key) sent as Authorization header.
VITE_API_KEY=
# Booking reference loaded at the start of the call.
VITE_BOOKING_REF=ABC123
